generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  phone               String?             @unique
  passwordHash        String
  role                UserRole            @default(USER)
  status              UserStatus          @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  invitedById         String?
  referralCode        String?             @unique
  auditLogs           AuditLog[]          @relation("AuditActor")
  messages            CommunityMessage[]
  payoutDestinations  PayoutDestination[]
  assignedRecharges   RechargeRequest[]   @relation("RechargeAssignee")
  reviewedRecharges   RechargeRequest[]   @relation("RechargeReviewer")
  rechargeRequests    RechargeRequest[]   @relation("RechargeOwner")
  subscriptions       Subscription[]
  transactions        Transaction[]
  sessions            UserSession[]
  invitedBy           User?               @relation("UserReferrals", fields: [invitedById], references: [id])
  invitees            User[]              @relation("UserReferrals")
  wallet              Wallet?
  assignedWithdrawals Withdrawal[]        @relation("WithdrawalAssignee")
  reviewedWithdrawals Withdrawal[]        @relation("WithdrawalReviewer")

  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model RateLimitBucket {
  id              String    @id
  hits            Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("rate_limit_buckets")
}

model Robot {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  description         String
  strategyDescription String
  market              String
  riskLevel           String
  robotType           String
  status              RobotStatus      @default(DRAFT)
  performanceKind     PerformanceKind?
  performanceSummary  String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tier                RobotTier        @default(BEGINNER)
  imageData           Bytes?
  imageContentType    String?          @db.VarChar(32)
  plans               RobotPlan[]
  subscriptions       Subscription[]
  transactions        Transaction[]

  @@map("robots")
}

model RobotPlan {
  id                    String         @id @default(cuid())
  robotId               String
  name                  String
  description           String?
  durationDays          Int
  price                 Decimal        @db.Decimal(18, 2)
  currency              String         @db.VarChar(3)
  status                PlanStatus     @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  dailyReturnPercentage Decimal        @default(0) @db.Decimal(5, 2)
  robot                 Robot          @relation(fields: [robotId], references: [id])
  subscriptions         Subscription[]

  @@index([robotId, status])
  @@map("robot_plans")
}

model Wallet {
  id               String         @id @default(cuid())
  userId           String         @unique
  currency         String         @db.VarChar(3)
  availableBalance Decimal        @default(0) @db.Decimal(18, 2)
  pendingBalance   Decimal        @default(0) @db.Decimal(18, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  growthBalance    Decimal        @default(0) @db.Decimal(18, 2)
  ledgerEntries    WalletLedger[]
  user             User           @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(18, 2)
  currency        String            @db.VarChar(3)
  reference       String            @unique
  description     String?
  idempotencyKey  String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  robotId         String?
  subscriptionId  String?
  payment         Payment?
  rechargeRequest RechargeRequest?
  robot           Robot?            @relation(fields: [robotId], references: [id], onDelete: Restrict)
  subscription    Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id])
  ledgerEntries   WalletLedger[]
  withdrawal      Withdrawal?

  @@index([userId, createdAt])
  @@index([subscriptionId, type, createdAt])
  @@map("transactions")
}

model WalletLedger {
  id            String            @id @default(cuid())
  walletId      String
  transactionId String
  entryType     LedgerEntryType
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @db.VarChar(3)
  balanceBefore Decimal           @db.Decimal(18, 2)
  balanceAfter  Decimal           @db.Decimal(18, 2)
  reference     String
  createdAt     DateTime          @default(now())
  balanceType   WalletBalanceType @default(MAIN)
  transaction   Transaction       @relation(fields: [transactionId], references: [id])
  wallet        Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@map("wallet_ledger")
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  robotId               String
  robotPlanId           String
  status                SubscriptionStatus @default(PENDING)
  price                 Decimal            @db.Decimal(18, 2)
  currency              String             @db.VarChar(3)
  startAt               DateTime?
  expiresAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  idempotencyKey        String?            @unique
  dailyReturnPercentage Decimal            @default(0) @db.Decimal(5, 2)
  daysCompleted         Int                @default(0)
  lastCreditedAt        DateTime?
  robot                 Robot              @relation(fields: [robotId], references: [id])
  robotPlan             RobotPlan          @relation(fields: [robotPlanId], references: [id])
  user                  User               @relation(fields: [userId], references: [id])
  earnings              Transaction[]

  @@index([status, expiresAt])
  @@index([userId, status])
  @@index([status, lastCreditedAt])
  @@map("subscriptions")
}

model CronJobRun {
  id             String    @id @default(cuid())
  job            String
  status         String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  processedCount Int       @default(0)
  failedCount    Int       @default(0)
  errorSummary   String?

  @@index([job, startedAt])
  @@map("cron_job_runs")
}

model Payment {
  id                String        @id @default(cuid())
  transactionId     String        @unique
  provider          String
  providerReference String?       @unique
  status            PaymentStatus @default(PENDING)
  rawStatus         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transaction       Transaction   @relation(fields: [transactionId], references: [id])

  @@map("payments")
}

model Withdrawal {
  id                  String             @id @default(cuid())
  transactionId       String             @unique
  status              WithdrawalStatus   @default(PENDING)
  destinationToken    String
  reviewReason        String?
  reviewedById        String?
  processedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  assignedAgentId     String?
  fee                 Decimal            @default(0) @db.Decimal(18, 2)
  netPayout           Decimal            @default(0) @db.Decimal(18, 2)
  payoutDestinationId String?
  sourceBalance       WalletBalanceType  @default(MAIN)
  assignedAgent       User?              @relation("WithdrawalAssignee", fields: [assignedAgentId], references: [id])
  payoutDestination   PayoutDestination? @relation(fields: [payoutDestinationId], references: [id], onDelete: Restrict)
  reviewedBy          User?              @relation("WithdrawalReviewer", fields: [reviewedById], references: [id])
  transaction         Transaction        @relation(fields: [transactionId], references: [id])

  @@map("withdrawals")
}

model RechargeRequest {
  id              String         @id @default(cuid())
  userId          String
  assignedAgentId String
  amount          Decimal        @db.Decimal(18, 2)
  currency        String         @default("USD") @db.VarChar(3)
  status          RechargeStatus @default(PENDING)
  transactionId   String?        @unique
  idempotencyKey  String?        @unique
  reviewReason    String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paymentMethod   String         @default("AGENT") @db.VarChar(20)
  cryptoName      String?        @db.VarChar(40)
  cryptoNetwork   String?        @db.VarChar(60)
  cryptoAddress   String?        @db.VarChar(200)
  assignedAgent   User           @relation("RechargeAssignee", fields: [assignedAgentId], references: [id])
  reviewedBy      User?          @relation("RechargeReviewer", fields: [reviewedById], references: [id])
  transaction     Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user            User           @relation("RechargeOwner", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([assignedAgentId, status, createdAt])
  @@map("recharge_requests")
}

model PayoutDestination {
  id                     String       @id @default(cuid())
  userId                 String
  category               String       @db.VarChar(20)
  provider               String       @db.VarChar(80)
  accountHolder          String       @db.VarChar(120)
  accountNumberEncrypted String
  accountNumberLast4     String       @db.VarChar(4)
  isDefault              Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  user                   User         @relation(fields: [userId], references: [id])
  withdrawals            Withdrawal[]

  @@index([userId, isDefault])
  @@map("payout_destinations")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model CommunityRoom {
  id                 String             @id @default(cuid())
  name               String             @unique
  description        String?
  isAnnouncementRoom Boolean            @default(false)
  createdAt          DateTime           @default(now())
  messages           CommunityMessage[]

  @@map("community_rooms")
}

model CommunityMessage {
  id         String        @id @default(cuid())
  roomId     String
  authorId   String
  body       String        @db.VarChar(4000)
  replyToId  String?
  reportedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  author     User          @relation(fields: [authorId], references: [id])
  room       CommunityRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@map("community_messages")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// Administrator-controlled platform settings. A single row (id "default")
/// keeps money logic pointing at one source of truth.
model PlatformSetting {
  id                      String   @id @default("default")
  /// How many Rwandan francs equal one US dollar (used for off-platform settlement).
  usdToRwfRate            Decimal  @default(1400) @db.Decimal(18, 4)
  /// Percentage fee deducted from every withdrawal request.
  withdrawalFeePercent    Decimal  @default(10) @db.Decimal(5, 2)
  /// Percentage of a confirmed recharge credited to the inviter, when set.
  referralBonusPercent    Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt               DateTime @updatedAt
  updatedById             String?
  /// Minimum gross amount accepted for a new deposit request.
  minimumDepositAmount    Decimal  @default(3000) @db.Decimal(18, 2)
  /// Minimum gross amount accepted for a new withdrawal request.
  minimumWithdrawalAmount Decimal  @default(1000) @db.Decimal(18, 2)

  @@map("platform_settings")
}

model CryptoWallet {
  id        String   @id
  name      String   @db.VarChar(40)
  network   String   @db.VarChar(60)
  address   String   @db.VarChar(200)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([enabled, name])
  @@map("crypto_wallets")
}

enum UserRole {
  USER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RobotStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RobotTier {
  BEGINNER
  PRO
  ADVANCED
  VIP
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  REFUND
  ADJUSTMENT
  FEE
  REFERRAL_BONUS
  ROBOT_EARNING
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  SUBSCRIPTION
  REFUND
  ADJUSTMENT
  FEE
  REFERRAL_BONUS
  ROBOT_EARNING
}

enum RechargeStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum WalletBalanceType {
  MAIN
  GROWTH
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PerformanceKind {
  SIMULATED
  HISTORICAL
  REAL
}
